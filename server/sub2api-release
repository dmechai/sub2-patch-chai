#!/usr/bin/env bash
set -Eeuo pipefail

deploy_path=/root/sub2api-deploy
state_dir=/var/lib/sub2api-release
compose_file=docker-compose.local.yml
override_file=docker-compose.patch.yml
allowed_image_prefix=ghcr.io/dmechai/sub2api-custom

die() {
  echo "ERROR: $*" >&2
  exit 1
}

validate_id() {
  [[ "${1:-}" =~ ^[0-9]+$ ]] || die "invalid deployment id"
}

validate_image() {
  [[ "${1:-}" =~ ^${allowed_image_prefix}:(latest|v[0-9]+\.[0-9]+\.[0-9]+-dotfix)$ ]] \
    || die "image must be a Sub2API candidate tag"
}

write_override() {
  local image_ref=$1
  local temp_file
  temp_file=$(mktemp "${deploy_path}/.docker-compose.patch.XXXXXX.yml")
  cat > "${temp_file}" <<EOF
services:
  sub2api:
    image: ${image_ref}
EOF
  chmod 600 "${temp_file}"
  mv "${temp_file}" "${deploy_path}/${override_file}"
}

wait_healthy() {
  local attempts=${1:-30}
  for _ in $(seq 1 "${attempts}"); do
    if docker exec sub2api wget -q -T 3 -O /dev/null http://127.0.0.1:8080/health 2>/dev/null; then
      return 0
    fi
    sleep 2
  done
  return 1
}

compose_up() {
  (cd "${deploy_path}" && docker compose \
    -f "${compose_file}" -f "${override_file}" \
    up -d --no-deps --pull never sub2api)
}

load_state() {
  local deployment_id=$1
  local state_file="${state_dir}/deployment-${deployment_id}.env"
  [[ -f "${state_file}" ]] || die "deployment state ${deployment_id} not found"
  # shellcheck disable=SC1090
  source "${state_file}"
}

rollback_deployment() {
  local deployment_id=$1
  load_state "${deployment_id}"
  docker image inspect "${ROLLBACK_IMAGE}" >/dev/null \
    || die "rollback image ${ROLLBACK_IMAGE} is missing"
  write_override "${ROLLBACK_IMAGE}"
  compose_up
  wait_healthy 30 || die "rollback container did not become healthy"
  docker exec sub2api /app/sub2api --version 2>&1 | head -n 1
  echo "Rolled back deployment ${deployment_id} to ${ROLLBACK_IMAGE}"
}

prepare() {
  local deployment_id=$1
  local image_ref=$2
  validate_id "${deployment_id}"
  validate_image "${image_ref}"
  install -d -m 700 "${state_dir}"

  [[ $(docker inspect --format '{{.State.Status}}' sub2api) == running ]] \
    || die "current Sub2API container is not running"
  docker exec sub2api wget -q -T 3 -O /dev/null http://127.0.0.1:8080/health \
    || die "current Sub2API health endpoint failed"

  docker pull "${image_ref}"
  local candidate_digest candidate_image_id source_label version_label
  candidate_digest=$(docker image inspect --format '{{index .RepoDigests 0}}' "${image_ref}")
  candidate_image_id=$(docker image inspect --format '{{.Id}}' "${image_ref}")
  source_label=$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.source"}}' "${image_ref}")
  version_label=$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.version"}}' "${image_ref}")
  [[ "${source_label}" == https://github.com/Wei-Shaw/sub2api ]] \
    || die "candidate image source label is unexpected"
  [[ "${version_label}" == *-dotfix ]] \
    || die "candidate image version label is unexpected"
  docker run --rm --entrypoint /app/sub2api "${candidate_image_id}" --version

  local current_container rollback_image state_file
  current_container=$(docker inspect --format '{{.Id}}' sub2api)
  rollback_image="sub2api-rollback:${deployment_id}"
  docker commit --pause=false sub2api "${rollback_image}" >/dev/null
  state_file="${state_dir}/deployment-${deployment_id}.env"
  {
    printf 'DEPLOYMENT_ID=%q\n' "${deployment_id}"
    printf 'ORIGINAL_CONTAINER=%q\n' "${current_container}"
    printf 'CANDIDATE_IMAGE=%q\n' "${candidate_digest}"
    printf 'CANDIDATE_IMAGE_ID=%q\n' "${candidate_image_id}"
    printf 'ROLLBACK_IMAGE=%q\n' "${rollback_image}"
  } > "${state_file}"
  chmod 600 "${state_file}"
  echo "Prepared ${candidate_digest}; current service was not restarted."
}

activate() {
  local deployment_id=$1
  validate_id "${deployment_id}"
  load_state "${deployment_id}"
  [[ $(docker inspect --format '{{.Id}}' sub2api) == "${ORIGINAL_CONTAINER}" ]] \
    || die "running container changed after preflight; refusing deployment"
  [[ $(docker image inspect --format '{{.Id}}' "${CANDIDATE_IMAGE}") == "${CANDIDATE_IMAGE_ID}" ]] \
    || die "prepared candidate image no longer matches"

  install -d -m 700 "${state_dir}"
  printf '%s\n' "${deployment_id}" > "${state_dir}/latest-deployment"
  write_override "${CANDIDATE_IMAGE}"
  if ! compose_up || ! wait_healthy 30; then
    echo "Candidate activation failed; starting automatic rollback." >&2
    rollback_deployment "${deployment_id}"
    exit 1
  fi
  docker exec sub2api /app/sub2api --version 2>&1 | head -n 1
  echo "Activated ${CANDIDATE_IMAGE}"
}

rollback() {
  local deployment_id=${1:-latest}
  if [[ "${deployment_id}" == latest ]]; then
    [[ -f "${state_dir}/latest-deployment" ]] || die "no deployment is available to roll back"
    deployment_id=$(<"${state_dir}/latest-deployment")
  fi
  validate_id "${deployment_id}"
  rollback_deployment "${deployment_id}"
}

case "${1:-}" in
  prepare)
    [[ $# == 3 ]] || die "usage: sub2api-release prepare DEPLOYMENT_ID IMAGE"
    prepare "$2" "$3"
    ;;
  activate)
    [[ $# == 2 ]] || die "usage: sub2api-release activate DEPLOYMENT_ID"
    activate "$2"
    ;;
  rollback)
    [[ $# == 1 || $# == 2 ]] || die "usage: sub2api-release rollback [DEPLOYMENT_ID]"
    rollback "${2:-latest}"
    ;;
  *)
    die "allowed commands: prepare, activate, rollback"
    ;;
esac
